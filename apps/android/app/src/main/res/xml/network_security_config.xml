<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production traffic is TLS only. The debug manifest overlay permits the
         local development topology; no release build may enable cleartext. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
