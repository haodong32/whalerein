{
  "name": "whalerein-dsh",
  "version": "0.1.0",
  "description": "WhaleRein for DSH: remote-control protocol endpoint plus Settings page",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./adapter": "./src/adapter/index.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "bin",
    "src",
    "README.md",
    "client.js",
    "icon.svg",
    "locale/*.json"
  ],
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "lint": "node ../../tools/repo/js/check-node-syntax.mjs index.js client.js bin src test",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-include=\"index.js\" --test-coverage-include=\"client.js\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 test/*.test.js",
    "dev": "node --watch bin/dev.js",
    "start": "bash bin/start-real-dsh.sh"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "mqtt": "^5.16.1",
    "protobufjs": "^8.8.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "whalerein-host": "workspace:*"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  },
  "bin": {
    "whalerein-dsh-fake": "bin/run-fake.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "packageManager": "pnpm@12.21.0"
}
