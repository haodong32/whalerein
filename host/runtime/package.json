{
  "name": "whalerein-host",
  "version": "0.1.0",
  "type": "module",
  "description": "WhaleRein shared host runtime and source contract",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./*": "./src/*"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "lint": "node ../../tools/repo/js/check-node-syntax.mjs src test",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 test/*.test.js"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "mqtt": "^5.16.1",
    "protobufjs": "^8.8.1"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  },
  "packageManager": "pnpm@12.18.0",
  "license": "AGPL-3.0-only"
}
